# ---------------------------------------------------------------------------
# Multi-outlet website (Next.js) — copy to .env.local and fill in. NEVER commit real secrets.
# The website has NO database: it reads and writes only through the Multi-outlet API.
# ---------------------------------------------------------------------------

# Multi-outlet API base URL (apps/multioutlet_api — the dedicated CodeIgniter backend). Server-side only.
POS_API_URL=http://localhost:8094/

# --- Credential (server-side only, never sent to browsers) — pick ONE ------------------------------
# 1) One business: its website key (POS › Website › Multi-outlet › Website key). The key names the
#    business, so the website always shows it (no ?site=).
#MULTISITE_KEY=mk_live_...
# 2) Platform-hosted, every business on <slug>.<siteHost>: the platform's storefront gateway token
#    (same value as omnipos.storefrontGatewayToken in the API's .env). Locally choose with ?site=<slug>.
MULTISITE_KEY=

# Hosts where ?site=<slug> may choose the website (development only).
DEV_HOSTS=localhost,127.0.0.1,::1

# Brand shown on error pages and "Powered by"
BRAND_NAME=BizPilot360X

# Products per page on listings, API timeout in ms
PER_PAGE=24
API_TIMEOUT_MS=8000

# Secret used to sign the human-check / form-age tokens (any long random string, `openssl rand -hex 32`)
SHIELD_SECRET=change-me-to-a-long-random-string
# Optional Cloudflare Turnstile (replaces the arithmetic question when both are set)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Set to 1 when served over HTTPS (marks cookies Secure)
COOKIE_SECURE=0
