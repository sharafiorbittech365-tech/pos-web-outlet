#--------------------------------------------------------------------
# Storefront API — production environment
# Copy to .env and fill in the secrets. Never commit .env.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# BRAND & BASE URL — the single source of truth for every domain.
# Every URL this file leaves unset is derived from the Base URL: app.baseURL and the sibling apps
# (admin., pos., api., market., developers.<domain>), hosted websites <slug>.<domain>.
#--------------------------------------------------------------------
omnipos.appName = BizPilot360X
omnipos.baseURL = https://bizpilot360x.com/

app.baseURL = 'https://storefront-api.bizpilot360x.com/'
# this API's own address: media links (/media/…) it serves point here
omnipos.apiUrl = https://storefront-api.bizpilot360x.com/
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

omnipos.appRole = api

#--------------------------------------------------------------------
# DATABASE — the central database, least-privilege account for this app
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = omnipos
database.default.username = omnipos_api
database.default.password = change-me-api
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306
database.default.numberNative = true

database.tests.hostname = 127.0.0.1
database.tests.database = omnipos_test
database.tests.username = omnipos_migrator
database.tests.password = change-me-migrator
database.tests.DBDriver = MySQLi
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
database.tests.DBPrefix =

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
# php spark key:generate
encryption.key =
security.csrfProtection = 'session'
security.tokenRandomize = true

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'omnipos_sfapi'
session.expiration = 7200
session.matchIP = false
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# CACHE (file in development; set redis in production)
#--------------------------------------------------------------------
cache.handler = 'redis'
cache.prefix = 'omnipos_sfapi_'
cache.redis.host = 127.0.0.1
cache.redis.port = 6379

logger.threshold = 4

# Hosted storefront gateway — generate with: php -r "echo \"sfg_\".bin2hex(random_bytes(24));"
omnipos.storefrontGatewayToken =

# cache shared by all apps: a common folder for the file handler (dev), empty with Redis (production)
omnipos.sharedCachePath =
