# ---------------------------------------------------------------------------
# Storefront (Next.js) — copy to .env.local and fill in. NEVER commit real secrets.
# The storefront has NO database: it reads and writes only through the API Service.
# ---------------------------------------------------------------------------

# Storefront API base URL (apps/storefront_api — the dedicated CodeIgniter backend). Server-side only.
POS_API_URL=http://localhost:8093/

# --- How this storefront authenticates against the API (pick ONE mode) ---------------------------
# 1) Platform-hosted (<slug>.yourdomain): the shared gateway token (same value as in the API's .env)
STOREFRONT_GATEWAY_TOKEN=
# 2) Self-hosted on a shop's own domain: CLIENT_ID + CLIENT_SECRET (server-side only)
CLIENT_ID=
CLIENT_SECRET=
# 3) Site key: set STOREFRONT_GATEWAY_TOKEN to the shop's pk_live_… key (the key names the shop)

# Hosts where ?site=<slug> is allowed to choose the shop (development only).
DEV_HOSTS=localhost,127.0.0.1,::1

# Brand shown on error pages and "Powered by"
BRAND_NAME=BizPilot360X

# Products per page on listing pages, API timeout in ms
PER_PAGE=24
API_TIMEOUT_MS=8000

# Secret used to sign the human-check / form-age tokens (any long random string, `openssl rand -hex 32`)
SHIELD_SECRET=change-me-to-a-long-random-string
# Optional Cloudflare Turnstile (replaces the arithmetic question when both are set)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Set to 1 when served over HTTPS (marks cookies Secure)
COOKIE_SECURE=0
