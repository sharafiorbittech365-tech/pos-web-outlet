# ---------------------------------------------------------------------------
# Marketplace (Next.js) — copy to .env.local and fill in. NEVER commit real secrets.
# The website has NO database: it reads and writes only through the Marketplace API.
# ---------------------------------------------------------------------------

# Marketplace API base URL (apps/marketplace_api — the dedicated CodeIgniter backend). Server-side only.
MARKETPLACE_API_URL=http://localhost:8095/
# Shared secret: the same value as market.apiToken in apps/marketplace_api/.env (server-side only).
MARKETPLACE_API_TOKEN=

# Brand shown in the header, titles and footer
BRAND_NAME=BizPilot360X

# API timeout in ms
API_TIMEOUT_MS=8000

# Secret used to sign the human-check / form-age tokens (any long random string, `openssl rand -hex 32`)
SHIELD_SECRET=change-me-to-a-long-random-string
# Optional Cloudflare Turnstile (replaces the arithmetic question when both are set)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Set to 1 when served over HTTPS (marks cookies Secure)
COOKIE_SECURE=0
